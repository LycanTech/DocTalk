# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://doctalk:doctalk@localhost:5432/doctalk_dev

# ─── Authentication ────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-64
JWT_REFRESH_SECRET=change-me-in-production-use-openssl-rand-base64-64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CouchDB / PouchDB offline sync ────────────────────────────────────────
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# For dev: use Mailtrap (https://mailtrap.io) or Mailhog (Docker)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-password
EMAIL_FROM=DocTalk <noreply@doctalk.ng>

# ─── Web Push Notifications (VAPID) ────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_EMAIL=admin@doctalk.ng
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ─── File Storage ──────────────────────────────────────────────────────────
# Local path for dev; use S3/Azure Blob in production
UPLOAD_DIR=./uploads

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug
